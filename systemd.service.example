[Unit]
Description=Oracle VPS Multi-Agent
After=network.target docker.service

[Service]
WorkingDirectory=/home/ubuntu/Agentic-AI
EnvironmentFile=/home/ubuntu/Agentic-AI/.env
ExecStart=/home/ubuntu/Agentic-AI/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
