# Model gateway. Defaults preserve the existing OpenRouter configuration.
# For a self-hosted OpenAI-compatible gateway, set AI_BASE_URL to its chat-completions
# endpoint and AI_API_KEY to the gateway key.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Architect plans/reviews; worker performs tool-backed investigation.
# Use distinct model IDs supported by your gateway for real model diversity.
ARCHITECT_MODEL=
WORKER_MODEL=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Oracle VPS Agent
AI_REQUEST_TIMEOUT=120
AGENT_API_TOKEN=
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_WORKSPACE_ROOTS=/home/ubuntu
# Detached coding worktrees live here; keep this directory on the mounted persistent workspace.
AGENT_CODING_WORKSPACE_ROOT=/home/ubuntu/.agent-workspaces
MAX_AGENT_TURNS=24

# Continuous read-only VPS monitor.
MONITOR_INTERVAL_SECONDS=300
MONITOR_CONTAINERS=home,docker-control-bot,agentic-ai
MONITOR_HEALTH_URLS=http://host.docker.internal:10000/health
MONITOR_LOG_SINCE=10m
MONITOR_LOG_TAIL=120
MONITOR_RECOVERY_MISSES=2
MONITOR_CPU_ALERT_PERCENT=95
MONITOR_MEMORY_ALERT_PERCENT=90
