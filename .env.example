AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Oracle VPS Agent
AGENT_API_TOKEN=
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_WORKSPACE_ROOTS=/home/ubuntu
MAX_AGENT_TURNS=24

# Continuous read-only VPS monitor.
MONITOR_INTERVAL_SECONDS=300
MONITOR_CONTAINERS=home,docker-control-bot,agentic-ai
MONITOR_HEALTH_URLS=http://host.docker.internal:10000/health
MONITOR_LOG_SINCE=10m
MONITOR_LOG_TAIL=120
MONITOR_RECOVERY_MISSES=2
MONITOR_CPU_ALERT_PERCENT=95
MONITOR_MEMORY_ALERT_PERCENT=90
