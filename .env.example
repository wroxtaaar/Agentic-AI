# Keep this file private; never commit production secrets.
AGENT_API_TOKEN=
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_WORKSPACE_ROOTS=/home/ubuntu
AGENT_CODING_WORKSPACE_ROOT=/home/ubuntu/.agent-workspaces

# FreeLLMAPI gateway. Deployment generates and persists the encryption key
# on the VPS. Add the unified API key from its dashboard here.
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_API_KEY=
AI_BASE_URL=http://freellmapi:3001/v1/chat/completions
AI_API_KEY=
OPENROUTER_API_KEY=
# "auto" is a safe initial selector; replace with exact IDs from the live
# FreeLLMAPI /v1/models catalogue after enabling provider keys.
ARCHITECT_MODEL=auto
WORKER_MODEL=auto
AI_REQUEST_TIMEOUT=180
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Oracle VPS Agent
MAX_AGENT_TURNS=24

MONITOR_INTERVAL_SECONDS=300
MONITOR_CONTAINERS=home,docker-control-bot,agentic-ai,freellmapi
MONITOR_HEALTH_URLS=http://host.docker.internal:10000/health
MONITOR_LOG_SINCE=10m
MONITOR_LOG_TAIL=120
MONITOR_RECOVERY_MISSES=2
MONITOR_CPU_ALERT_PERCENT=95
MONITOR_MEMORY_ALERT_PERCENT=90
